{
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "remix-learning-ecommerce.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "build/client",
  "installCommand": "npm install"
}
